# A long-lived curl-capable pod with NET_ADMIN so its initContainer
# can install a static route for 203.0.113.100 via the FRR pod IP
# (learned at scenario-apply time from `scn-bgp` namespace).
#
# With that route in place, packets from this pod to 203.0.113.100
# go to the FRR pod, which has a BGP-learned route to the TMM pod IP
# and forwards them in. TMM's Gateway listener receives the request
# and proxies to the nginx Service.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: scn-curl
  namespace: scn-httproute-e2e
  labels: {app: scn-curl}
spec:
  replicas: 1
  selector:
    matchLabels: {app: scn-curl}
  template:
    metadata:
      labels: {app: scn-curl}
    spec:
      initContainers:
      - name: route
        image: curlimages/curl:8.10.1
        securityContext:
          capabilities: {add: [NET_ADMIN]}
          runAsUser: 0
        command:
        - sh
        - -c
        - |
          set -e
          ip route replace 203.0.113.100/32 via {{.FRRPodIP}}
          ip route
      containers:
      - name: curl
        image: curlimages/curl:8.10.1
        command: ["sh", "-c", "while true; do sleep 3600; done"]
        resources:
          requests: {cpu: 10m, memory: 16Mi}
          limits:   {cpu: 100m, memory: 32Mi}
