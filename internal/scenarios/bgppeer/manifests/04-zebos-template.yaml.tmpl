# Patches the existing f5-tmm-dynamic-routing-template ConfigMap with
# a ZeBOS BGP config that peers with the FRR pod at runtime. The
# {{.FRRPodIP}} placeholder is filled by the scenario's Apply step
# after the FRR pod gets a Calico IP. ZeBOS reads %%POD_IP%% itself
# at TMM startup so we don't have to know TMM's IP at apply time.
#
# `network 203.0.113.100/32` is what we ultimately want learned on
# the FRR side. It's advertised even without a matching kernel route,
# which suits the static-gateway-address shape kindbnkctl uses.
apiVersion: v1
kind: ConfigMap
metadata:
  name: f5-tmm-dynamic-routing-template
  namespace: default
data:
  ZebOS.conf: |
    !
    ! NOTE: F5 ZeBOS rejects 'ip route X/N <iface>' syntax with
    ! "ECMP route cannot be created with nexthop as IFNAME"; static
    ! routes must use a next-hop IP. The Calico-subnet route we
    ! need (to push BGP traffic via eth0 rather than the default
    ! tmm virtio) is therefore injected into the TMM pod's kernel
    ! netns by the scenario's separate route-injector Job —
    ! see manifests/05-route-injector.yaml.
    !
    router bgp 65000
      bgp router-id %%POD_IP%%
      bgp log-neighbor-changes
      no bgp default ipv4-unicast
      !
      neighbor {{.FRRPodIP}} remote-as 65001
      neighbor {{.FRRPodIP}} update-source eth0
      !
      address-family ipv4
        network 203.0.113.100/32
        neighbor {{.FRRPodIP}} activate
        neighbor {{.FRRPodIP}} soft-reconfiguration inbound
      exit-address-family
    !
